@model List<Capstone_toDoList.Models.TaskItem>
@{
    ViewData["Title"] = "Deleted Tasks";
}

<h1 style="margin-bottom:0">Deleted Tasks</h1>

<div class="task-lists-header">
    <div class="dropdown">
        <button class="dropbtn">Category</button>
        <div class="dropdown-category">
            <a asp-action="Deleted" asp-route-category="School">School</a>
            <a asp-action="Deleted" asp-route-category="Household">House</a>
            <a asp-action="Deleted" asp-route-category="Work">Work</a>
            <a asp-action="Deleted" asp-route-category="Hobby">Hobby</a>
            <a asp-action="Deleted" asp-route-category="Others">Others</a>
        </div>
    </div>

    <div class="dropdown">
        <button class="dropbtn">Date Deleted</button>
        <div class="dropdown-due">
            <a asp-action="Deleted" asp-route-sortOrder="Newest">Newest First</a>
            <a asp-action="Deleted" asp-route-sortOrder="Oldest">Oldest First</a>
        </div>
    </div>
</div>

<div class="task-container">
    @foreach (var task in Model)
    {
        <div class="task-card">
            <div class="task-card-header">
                <h3>@task.Title</h3>
                <h4>@task.Id - <span style="color: gray">Deleted</span></h4>
            </div>

            <p>@task.Description</p>
            <p><strong>Category:</strong> @task.Category</p>
            <p><strong>Date Started:</strong> @task.DateStarted.ToShortDateString()</p>
            <p><strong>Due:</strong> @task.DueDate.ToShortDateString()</p>
            <p><strong>Date Completed:</strong> @(task.DateCompleted?.ToShortDateString() ?? "-")</p>
            <p><strong>Date Deleted:</strong> @(task.DateDeleted?.ToShortDateString() ?? "-")</p>
            <p><strong>Assigned to:</strong> @task.AssignedTo</p>
            <p><strong>Status:</strong> DELETED ✅</p>

           <!--Restore button-->
            <form asp-action="RestoreTask" method="post">
                <input type="hidden" name="taskId" value="@task.Id" />
                <button type="submit" class="confirm" id="restore-btn">Restore</button>
            </form>
            
        </div>
    }
</div>
